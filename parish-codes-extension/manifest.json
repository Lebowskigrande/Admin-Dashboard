{
  "manifest_version": 3,
  "name": "Parish Codes (Budget + Envelope)",
  "version": "3.0.0",
  "description": "Gmail routing shortcuts for AP and AR coding, with invoice handoff into the dashboard finance router.",
  "action": {
    "default_title": "Open Finance Router"
  },
  "commands": {
    "open-routing-modal": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the finance routing page"
    }
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://docs.google.com/spreadsheets/d/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
